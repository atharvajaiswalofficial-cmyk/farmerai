# ==============================================================================
# Sahayak AI Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# NEVER commit your actual .env file or service account credentials into git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication & Security Configuration
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=your-super-secret-jwt-signing-key-here-32-chars-min
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 2. OTP Provider Configuration
# Choose one of: 'console' (local dev testing), 'fast2sms', 'twilio', 'msg91', 'smtp'
# ------------------------------------------------------------------------------
OTP_PROVIDER=console

# --- Option A: Fast2SMS (Indian SMS Route - Quick OTP) ---
# Sign up at https://www.fast2sms.com and obtain your API authorization key
FAST2SMS_API_KEY=

# --- Option B: Twilio (International SMS) ---
# Sign up at https://www.twilio.com and obtain Account SID, Auth Token & Phone Number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Option C: MSG91 (India/Global SMS) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Option D: SMTP Server (Email OTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# ------------------------------------------------------------------------------
# 3. LLM & RAG Pipeline Configuration (FastAPI Backend)
# ------------------------------------------------------------------------------
# Google Gemini LLM Provider (Primary Grounded Generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative OpenAI-Compatible Provider
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# RAG Retrieval Configuration
RAG_TOP_K=5
RAG_DISTANCE_THRESHOLD=0.40

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Firebase Web Client SDK - Optional)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
